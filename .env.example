# ============================================================
# HONOR — Variables d'environnement requises
# ============================================================
# Copiez ce fichier en .env et renseignez chaque valeur.
# Ne jamais commiter le fichier .env dans git.
# ============================================================

# -----------------------------------------------------------
# Supabase — OBLIGATOIRE pour le fonctionnement du site
# -----------------------------------------------------------
# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé publique (anon key) — exposée côté client
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — JAMAIS exposée côté client, uniquement SSR/serveur
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------
# E-mails transactionnels — via Resend (https://resend.com)
# -----------------------------------------------------------
# Clé API Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Domaine expéditeur vérifié dans Resend (sous-domaine conseillé : notify.honor-fc.fr)
SENDER_DOMAIN=honor-fc.fr

# Adresse d'expédition (ex: atelier@honor-fc.fr)
EMAIL_FROM_USER=atelier
EMAIL_FROM_LABEL=HONOR Atelier

# Adresse interne recevant les formulaires de contact
# Par défaut automatique : info@honor-fc.fr
CONTACT_EMAIL_TO=info@honor-fc.fr

# -----------------------------------------------------------
# URL publique du site (utilisée dans les liens des e-mails)
# -----------------------------------------------------------
SITE_URL=https://www.honor-fc.fr

# -----------------------------------------------------------
# Optionnel — Overrides
# -----------------------------------------------------------
# Surcharge le domaine affiché dans l'adresse expéditeur
# FROM_DOMAIN=honor-fc.fr

# Clé secrète CSRF (TanStack Start) — générée automatiquement si absente
# CSRF_SECRET=une-longue-chaine-aleatoire-ici
